# Copy this file to .env and fill in your broker details, then restart the dev server.
# These values are embedded in the browser bundle, so use a broker account that is
# only allowed to read plant/data and publish to plant/cmd.
VITE_MQTT_URL=wss://your-broker-host:8884/mqtt
VITE_MQTT_USERNAME=dashboard
VITE_MQTT_PASSWORD=change-me
